# ONETAKE STUDIO — server configuration. Copy to .env and edit.

# HTTP port (default 8787)
PORT=8787
# Public base URL used in email links (verification / reset). No SMTP by default:
# those links are printed to the server console.
PUBLIC_URL=http://localhost:8787

# Required secret for encrypting stored provider credentials (AES-256-GCM).
# Generate: openssl rand -base64 32
VAULT_KEY=

# Required secret for signing session cookies. Generate: openssl rand -base64 32
SESSION_SECRET=

# Rendering worker
RENDER_CONCURRENCY=2
RENDER_TIMEOUT_MS=1800000
DATA_DIR=./data
# Path to python3 with playwright+numpy+pillow installed, and ffmpeg on PATH.
PYTHON_BIN=python3
FFMPEG_BIN=ffmpeg
# Log level: debug|info|warn|error
LOG_LEVEL=info

# Optional: Catbox.moe userhash so uploads are tied to your account
# (anonymous works without this; set on Render if you have one)
CATBOX_USERHASH=
